# Copy this file to .env and fill in your values.
# .env is gitignored and must NEVER be committed.

# MongoDB connection string
MONGO_URI_FINANCE=mongodb://localhost:27017/finance_db

# JWT signing secret — MUST be a Base64-encoded string of at least 32 random bytes.
# Generate one with: openssl rand -base64 32
# Never use the placeholder value below in production.
JWT_SECRET_FINANCE=YOUR_BASE64_ENCODED_SECRET_HERE
